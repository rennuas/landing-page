---
import '../styles/global.css';
import { Header } from '@/components/Header';
import { Footer } from '@/components/Footer';
import { CommandPalette } from '@/components/CommandPalette';
import { CookieConsent } from '@/components/CookieConsent';
const { title = "LamanPlus - UMKM Landing Page" } = Astro.props;
---

<html lang="en">
	<head>
		<!-- Basic Meta -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content="LamanPlus bantu UMKM Indonesia punya landing page profesional yang jualan, bukan cuma pajangan. Cepat 2-3 hari, harga terjangkau, didesain buat konversi." />
		<meta name="keywords" content="landing page UMKM, jasa pembuatan landing page, landing page murah, website UMKM, jasa website UMKM, landing page profesional Indonesia" />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="LamanPlus" />
		<link rel="canonical" href="https://lamanplus.web.id/about" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://lamanplus.web.id/about" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Kami bantu UMKM Indonesia bangun landing page profesional yang mengubah pengunjung jadi pembeli. Kerjain 2-3 hari, harga masuk akal, hasil nyata." />
		<meta property="og:image" content="https://lamanplus.web.id/og-image.jpg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:site_name" content="LamanPlus" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content="https://lamanplus.web.id/about" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content="Kami bantu UMKM Indonesia bangun landing page profesional yang mengubah pengunjung jadi pembeli. Kerjain 2-3 hari, harga masuk akal, hasil nyata." />
		<meta name="twitter:image" content="https://lamanplus.web.id/og-image.jpg" />

		<link rel="icon" href="/favicon.ico" sizes="any">
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<link
		href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
		rel="stylesheet"
		/>

		<!-- Structured Data (JSON-LD) -->
			<script type="application/ld+json">
			{
			"@context": "https://schema.org",
			"@type": "AboutPage",
			"name": "Tentang LamanPlus",
			"description": "LamanPlus bantu UMKM Indonesia punya landing page profesional yang jualan, bukan cuma pajangan.",
			"url": "https://lamanplus.web.id/about",
			"mainEntity": {
				"@type": "Organization",
				"name": "LamanPlus",
				"url": "https://lamanplus.web.id",
				"description": "Jasa pembuatan landing page profesional untuk UMKM Indonesia, cepat dan terjangkau.",
				"areaServed": "ID",
				"sameAs": [
				"https://wa.me/6285156286627"
				]
			}
		}
		</script>

	</head>
	<body>
		<Header client:load />
		<main>
			<slot />
		</main>
		<Footer />
		<CommandPalette client:load />
		<CookieConsent client:load />
	</body>
</html>
