---
import Layout from '../layouts/main.astro';
import { Button } from '@/components/ui/button';
import { Mail, MapPin, Phone, Send, Instagram } from 'lucide-react';
---

<Layout title="Hubungi Kami - LamanPlus">
	<section class="py-20 md:py-32">
		<div class="container mx-auto px-4">
			<div class="max-w-5xl mx-auto">
				<div class="text-center space-y-4 mb-16">
					<h1 class="text-4xl md:text-6xl font-bold">
						Hubungi{" "}
						<span class="bg-gradient-to-r from-purple-600 to-pink-600 dark:from-purple-400 dark:to-pink-400 bg-clip-text text-transparent">
							Kami
						</span>
					</h1>
					<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
						Ada pertanyaan atau mau bikin landing page untuk UMKM-mu? Kami siap bantu.
					</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
					<!-- Contact Form -->
					<div class="lg:col-span-2">
						<div class="p-8 rounded-2xl border bg-card">
							<h2 class="text-2xl font-bold mb-6">Kirim pesan ke kami</h2>
							<form class="space-y-6">
								<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
									<div>
										<label for="name" class="block text-sm font-medium mb-2">
											Nama
										</label>
										<input
											type="text"
											id="name"
											name="name"
											class="flex h-10 w-full rounded-md border bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
											placeholder="Nama Anda"
											required
										/>
									</div>
									<div>
										<label for="email" class="block text-sm font-medium mb-2">
											Email
										</label>
										<input
											type="email"
											id="email"
											name="email"
											class="flex h-10 w-full rounded-md border bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
											placeholder="nama@email.com"
											required
										/>
									</div>
								</div>

								<div>
									<label for="subject" class="block text-sm font-medium mb-2">
										Subjek
									</label>
									<input
										type="text"
										id="subject"
										name="subject"
										class="flex h-10 w-full rounded-md border bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
										placeholder="Ada yang bisa kami bantu?"
										required
									/>
								</div>

								<div>
									<label for="message" class="block text-sm font-medium mb-2">
										Pesan
									</label>
									<textarea
										id="message"
										name="message"
										rows="6"
										class="flex w-full rounded-md border bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring resize-none"
										placeholder="Ceritakan lebih lanjut soal bisnis atau kebutuhanmu..."
										required
									></textarea>
								</div>

								<button
									type="submit"
									class="inline-flex items-center justify-center gap-2 h-10 px-6 rounded-md bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors w-full md:w-auto"
								>
									<Send className="h-4 w-4" />
									Kirim Pesan
								</button>
							</form>
						</div>
					</div>

					<!-- Contact Info -->
					<div class="space-y-6">
						<div class="p-6 rounded-2xl border bg-card">
							<div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 mb-4">
								<Mail className="h-6 w-6 text-white" />
							</div>
							<h3 class="text-lg font-semibold mb-2">Email</h3>
							<p class="text-muted-foreground">hello@lamanplus.web.id</p>
						</div>

						<div class="p-6 rounded-2xl border bg-card">
							<div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 mb-4">
								<Phone className="h-6 w-6 text-white" />
							</div>
							<h3 class="text-lg font-semibold mb-2">WhatsApp</h3>
							<p class="text-muted-foreground">
								<a href="https://wa.me/6285156286627" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors">
									+62 851-5628-6627
								</a>
							</p>
						</div>

						<div class="p-6 rounded-2xl border bg-card">
							<div class="inline-flex p-3 rounded-xl bg-gradient-to-br from-green-500 to-emerald-500 mb-4">
								<MapPin className="h-6 w-6 text-white" />
							</div>
							<h3 class="text-lg font-semibold mb-2">Lokasi</h3>
							<p class="text-muted-foreground">
								Batam, Kepulauan Riau<br />
								Indonesia
							</p>
						</div>

						<!-- Social Links -->
						<div class="p-6 rounded-2xl border bg-card">
							<h3 class="text-lg font-semibold mb-4">Ikuti Kami</h3>
							<div class="flex gap-3">
								<a href="https://instagram.com/lamanplus" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center h-10 w-10 rounded-md border bg-background hover:bg-accent transition-colors">
									<Instagram className="h-5 w-5" />
								</a>
								<a href="https://wa.me/6285156286627" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center h-10 w-10 rounded-md border bg-background hover:bg-accent transition-colors">
									<Phone className="h-5 w-5" />
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>